# This file provides an example configuration for JustEncrypt, listing every
# variable it reads. Commented-out values are the defaults used when a variable
# is not set, except where a comment says the value is only an example.
#
# `cargo run` loads a `.env` file from the working directory, so copy this file
# to `.env` for local runs. With Docker, pass it with `--env-file`.



# The address the JustEncrypt server will bind to.
# JUSTENCRYPT_ADDRESS=0.0.0.0

# The port the JustEncrypt server will listen on.
# JUSTENCRYPT_PORT=8000

# The number of worker threads that handle incoming requests.
# JUSTENCRYPT_WORKERS=16

# The number of threads for work that blocks: database queries, file reads
# and writes, and image decoding. Shared by every user.
# JUSTENCRYPT_MAX_BLOCKING_THREADS=512



# The secret key the session cookies are encrypted with: 256 or 512 bits, as
# base64 or hex. This MUST be a strong, randomly generated key and kept secret;
# generate your own with `openssl rand -base64 32`. Release builds refuse to
# start without one; debug builds without one use a random key for each launch.
JUSTENCRYPT_SECRET_KEY=cEf+JLu65nEJorV9yG1OEsnUK1BgIwioDNcw/wi/MbU=

# The server speaks plain HTTP. For HTTPS, run it behind a reverse proxy that
# terminates TLS (see the README).

# Whether session cookies require HTTPS. Set to false for local development over HTTP.
# JUSTENCRYPT_SECURE_COOKIES=true

# The one origin whose pages may call the API from a browser, with cookies
# (CORS). It must match the browser's Origin header exactly: scheme, host and
# port, with no trailing slash. `*` is not allowed. If commented out, no
# cross-origin page is allowed. (Example value.)
# JUSTENCRYPT_ALLOW_ORIGIN=https://justencrypt.sheavesnet.ca

# API key for the admin routes, which are needed to create accounts (example
# value; use a long random one). If commented out, admin routes are disabled.
# JUSTENCRYPT_ADMIN_API_KEY=api_key



# The general logging level for the JustEncrypt application.
# Possible values: Off, Error, Warn, Info, Debug, Trace.
# JUSTENCRYPT_LOG_LEVEL=Warn

# The logging level for the HTTP server and its libraries. At Info, it also
# logs one line per request.
# Possible values: Off, Error, Warn, Info, Debug, Trace.
# JUSTENCRYPT_HTTP_LOG_LEVEL=Error



# The minimum security score (0-4) required for the password of a new account.
# JUSTENCRYPT_MINIMUM_PASSWORD_SECURITY_SCORE=4

# Session lifetime. A session expires after this many seconds without a request,
# or this many seconds after login, whichever comes first.
# JUSTENCRYPT_SESSION_IDLE_TIMEOUT_SECONDS=3600
# JUSTENCRYPT_SESSION_MAX_LIFETIME_SECONDS=604800

# Logging in beyond this many sessions ends the user's oldest session.
# JUSTENCRYPT_MAX_SESSIONS_PER_USER=5



# The base path where user-specific data will be stored.
# JUSTENCRYPT_USER_DATA_PATH=./user_data

# The minimum and maximum number of database connections per user. A user's
# database work waits for one of their own connections without holding a
# server thread, so a user who runs out slows down only themselves. Folder
# downloads may use at most half of them, leaving the rest for the user's other
# requests.
# JUSTENCRYPT_MIN_DB_CONNECTIONS_PER_USER=0
# JUSTENCRYPT_MAX_DB_CONNECTIONS_PER_USER=16

# The maximum time in seconds a database connection can be idle before being closed.
# JUSTENCRYPT_DB_IDLE_TIMEOUT_SECONDS=600

# The maximum time in seconds a request waits for one of its user's
# connections, folder download slots or (with
# JUSTENCRYPT_MAX_BLOCKING_THREADS_PER_USER set) blocking threads, before
# giving up with 429.
# JUSTENCRYPT_DB_CONNECTION_TIMEOUT_SECONDS=30

# The maximum time in milliseconds to wait when the database is busy.
# JUSTENCRYPT_DB_BUSY_TIMEOUT_MS=60000

# The synchronous mode for SQLite.
# Possible values: OFF, NORMAL, FULL, EXTRA.
# JUSTENCRYPT_DB_SYNCHRONOUS_MODE=NORMAL

# The size of the database disk cache in kilobytes.
# JUSTENCRYPT_DB_CACHE_SIZE_KB=16000

# Specifies where temporary files are stored.
# Possible values: DEFAULT, FILE, MEMORY.
# JUSTENCRYPT_DB_TEMP_STORE=MEMORY

# The maximum size in bytes for the database journal file.
# JUSTENCRYPT_DB_JOURNAL_SIZE_LIMIT_BYTES=67108864



# Maximum number of uploads a session may have in progress at once.
# Unset (the default) means no limit; 100 is an example value.
# JUSTENCRYPT_MAX_ACTIVE_UPLOADS=100

# Maximum number of folder downloads that may run at once, across all users.
# Each one holds a thread and one of its user's database connections until it
# finishes. Further downloads are rejected with 429.
# Unset (the default) means no limit; 4 is an example value.
# JUSTENCRYPT_MAX_ACTIVE_DOWNLOADS=4

# Maximum number of blocking threads one user's requests may occupy at once.
# Unset (the default) means no limit: a single busy user can take every one and
# slow down everyone else. Set it to keep users from affecting each other;
# requests over the limit wait without holding a thread. 16 is an example
# value.
# JUSTENCRYPT_MAX_BLOCKING_THREADS_PER_USER=16

# Seconds a file or folder download waits for the client to read more before
# it is abandoned, freeing what it holds (for a folder download, its slot and
# database connection).
# JUSTENCRYPT_DOWNLOAD_STALL_TIMEOUT_SECONDS=60

# Seconds an upload can sit idle before it is considered abandoned and removed.
# JUSTENCRYPT_UPLOAD_TTL_SECONDS=86400



# The largest file that may be stored, and the largest body of a single
# chunk-upload request.
# JUSTENCRYPT_LIMITS_FILE=64GiB
# JUSTENCRYPT_LIMITS_FILE_CHUNK=32MiB

# The largest JSON body (login, account creation and PATCH requests).
# JUSTENCRYPT_LIMITS_JSON=10MiB



# At most CONCURRENCY images are decoded at once (70% of the workers when
# unset), each using at most MAX_DECODE_MEMORY; larger images get no thumbnail.
# JUSTENCRYPT_THUMBNAIL_CONCURRENCY=11
# JUSTENCRYPT_THUMBNAIL_MAX_DECODE_MEMORY=256MiB



# How often, in seconds, a background job removes expired sessions and stale
# uploads. 0 (the default) disables it.
# JUSTENCRYPT_SESSION_REAPER_INTERVAL_SECONDS=0

# When true, every login starts a background job that removes that user's
# stored files that nothing refers to any more.
# JUSTENCRYPT_ORPHAN_SCAN_ENABLED=false
