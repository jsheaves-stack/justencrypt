# This file provides an example configuration for JustEncrypt.
# The values listed here are the default values used by the application
# if the corresponding environment variables are not set.

# The address the JustEncrypt server will bind to.
# JUSTENCRYPT_ADDRESS=0.0.0.0
# The port the JustEncrypt server will listen on.
# JUSTENCRYPT_PORT=8000
# The number of worker threads Rocket will use to handle incoming requests.
# JUSTENCRYPT_WORKERS=16
# The keep-alive timeout in seconds for HTTP connections.
# JUSTENCRYPT_KEEP_ALIVE=5
# The minimum security score required for user-provided passwords.
# JUSTENCRYPT_MINIMUM_PASSWORD_SECURITY_SCORE=3

# The logging level for the Rocket web framework.
# Possible values: Off, Critical, Normal, Debug.
# JUSTENCRYPT_ROCKET_LOG_LEVEL=Critical
# The general logging level for the JustEncrypt application.
# Possible values: Off, Error, Warn, Info, Debug, Trace.
# JUSTENCRYPT_LOG_LEVEL=Warn

# The base path where user-specific data will be stored.
# JUSTENCRYPT_USER_DATA_PATH=./user_data
# The minimum number of database connections to maintain per user.
# JUSTENCRYPT_MIN_DB_CONNECTIONS_PER_USER=0
# The maximum number of database connections allowed per user.
# JUSTENCRYPT_MAX_DB_CONNECTIONS_PER_USER=2
# The maximum time in seconds a database connection can be idle before being closed.
# JUSTENCRYPT_DB_IDLE_TIMEOUT_SECONDS=600
# The maximum time in milliseconds to wait when the database is busy.
# JUSTENCRYPT_DB_BUSY_TIMEOUT_MS=60000
# The synchronous mode for SQLite.
# JUSTENCRYPT_DB_SYNCHRONOUS_MODE=NORMAL
# The size of the database disk cache in kilobytes.
# JUSTENCRYPT_DB_CACHE_SIZE_KB=16000
# Specifies where temporary files are stored.
# JUSTENCRYPT_DB_TEMP_STORE=MEMORY
# The maximum size in bytes for the database journal file.
# JUSTENCRYPT_DB_JOURNAL_SIZE_LIMIT_BYTES=67108864
# The maximum time in seconds to wait for a database connection.
# JUSTENCRYPT_DB_CONNECTION_TIMEOUT_SECONDS=30

# Maximum number of concurrent active uploads allowed.
# JUSTENCRYPT_MAX_ACTIVE_UPLOADS=100

# Seconds an upload can sit idle before it is considered abandoned and removed.
# JUSTENCRYPT_UPLOAD_TTL_SECONDS=86400

# The secret key used by Rocket for signing cookies and managing sessions.
# This MUST be a strong, randomly generated key and kept secret.
# It does not have a stable default and should be set explicitly.
JUSTENCRYPT_ROCKET_SECRET_KEY=cEf+JLu65nEJorV9yG1OEsnUK1BgIwioDNcw/wi/MbU=

# The path to the TLS private key file for HTTPS.
# JUSTENCRYPT_TLS_KEY_PATH=/default.key
# The path to the TLS certificate file for HTTPS.
# JUSTENCRYPT_TLS_CERT_PATH=/default.crt

# The allowed origin for Cross-Origin Resource Sharing (CORS) requests.
# If commented out, no specific origin is set.
# JUSTENCRYPT_ALLOW_ORIGIN=https://justencrypt.sheavesnet.ca

# Whether session cookies require HTTPS. Set to false for local development over HTTP.
# JUSTENCRYPT_SECURE_COOKIES=true

# API key for administrative access. If commented out, admin routes are disabled.
# JUSTENCRYPT_ADMIN_API_KEY=api_key

# The maximum size for various types of request bodies.
# JUSTENCRYPT_LIMITS_FORM=10MiB
# JUSTENCRYPT_LIMITS_DATA_FORM=10MiB
# JUSTENCRYPT_LIMITS_FILE=64GiB
# JUSTENCRYPT_LIMITS_JSON=10MiB
# JUSTENCRYPT_LIMITS_MSGPACK=1MiB
# JUSTENCRYPT_LIMITS_FILE_JPG=10GiB
# JUSTENCRYPT_LIMITS_BYTES=10MiB
# JUSTENCRYPT_LIMITS_STRING=10MiB